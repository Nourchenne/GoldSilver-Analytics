# 13. DIAGNOSTIC DES RESIDUS
#
prev_train1 <- predict(
modele1,
train
)
residus1 <- train$y -
prev_train1$yhat
# ACF des r?sidus
acf(
residus1,
lag.max = 14,
main = "ACF des residus de Prophet"
)
# Test de Ljung-Box
Box.test(
residus1,
lag = 14,
type = "Ljung-Box"
)
# INTERPRETATION :
#
# H0 :
# absence d'autocorrelation globale
# des r?sidus jusqu'au retard ?tudi?.
#
# Si p-value > 0.05 :
# on ne rejette pas H0.
# Les r?sidus sont compatibles avec
# l'absence d'autocorr?lation significative.
#
# Si p-value < 0.05 :
# il reste une structure temporelle
# que le mod?le n'a pas totalement capt?e.
#
# Remarque :
# le diagnostic des r?sidus compl?te
# l'?valuation pr?dictive.
#
# Un mod?le peut avoir de bons r?sidus
# sans ?tre le meilleur pr?visionniste,
# d'o? l'importance de la validation hors ?chantillon.
#
# 14. AJOUT D'UNE VARIABLE EXOGENE : PROMOTION
#
set.seed(5)
promo <- rbinom(
n,
size = 1,
prob = 0.08
)
df_reg <- df
df_reg$promo <- promo
# Pour l'exercice p?dagogique,
# on simule un effet promotionnel de +45 ventes.
df_reg$y <- df_reg$y +
45 * df_reg$promo
train_reg <- df_reg[
1:(n - H),
]
test_reg <- df_reg[
(n - H + 1):n,
]
#
# Mod?le sans variable promotion
#
modele_sans_promo <- suppressMessages(
prophet(
train_reg[
,
c(
"ds",
"y"
)
]
)
)
prev_sans_promo <- predict(
modele_sans_promo,
test_reg[
,
"ds",
drop = FALSE
]
)
# ------------------------------------------------------------
# Mod?le avec variable promotion
# ------------------------------------------------------------
modele_promo <- prophet()
modele_promo <- add_regressor(
modele_promo,
"promo"
)
modele_promo <- suppressMessages(
fit.prophet(
modele_promo,
train_reg
)
)
prev_promo <- predict(
modele_promo,
test_reg[
,
c(
"ds",
"promo"
)
]
)
# Comparaison de la MAE
round(
c(
"Sans promotion" =
mean(
abs(
test_reg$y -
prev_sans_promo$yhat
)
),
"Avec promotion" =
mean(
abs(
test_reg$y -
prev_promo$yhat
)
)
),
2
)
# Effet moyen estim? de la promotion
mean(
prev_promo$promo[
test_reg$promo == 1
]
)
# INTERPRETATION :
#
# Si la MAE du mod?le avec promotion
# est plus faible,
# alors la variable promotion apporte
# une information pr?dictive suppl?mentaire.
#
# Le coefficient estim? pour "promo"
# mesure l'effet associ? aux jours
# de promotion.
#
# Attention :
# pour pr?voir le futur,
# la valeur de la variable promotion
# doit ?tre connue ? l'avance.
#
# Exemple :
# calendrier promotionnel d?j? planifi?.
# CONCLUSION
#
# Une analyse Prophet compl?te ne consiste pas
# uniquement ? estimer un mod?le.
#
# La d?marche recommand?e est :
#
# 1. Explorer la s?rie.
# 2. Construire un benchmark.
# 3. Estimer Prophet.
# 4. Examiner tendance et saisonnalit?s.
# 5. Etudier les changepoints.
# 6. Ajouter les ?v?nements pertinents.
# 7. Evaluer les performances hors ?chantillon.
# 8. Utiliser une validation crois?e temporelle.
# 9. Diagnostiquer les r?sidus.
# 10. Ajouter des r?gresseurs externes uniquement
#     lorsqu'ils ont un sens m?tier et qu'ils sont
#     disponibles au moment de la pr?vision.
#
# Un bon mod?le doit donc ?tre :
#
# - statistiquement coh?rent ;
# - performant hors ?chantillon ;
# - plus utile qu'un benchmark simple ;
# - interpr?table dans le contexte m?tier.
# INTERPRETATION :
# Le meilleur mod?le est celui qui pr?sente,
# sur les donn?es test :
# - une MAE plus faible ;
# - une RMSE plus faible ;
# - une MAPE plus faible.
#
# Cependant, de tr?s petits ?carts entre mod?les
# ne permettent pas forc?ment de conclure
# ? une sup?riorit? r?elle.
#
# 12. VALIDATION CROISEE TEMPORELLE
#
modele_cv <- suppressMessages(
prophet(
df,
holidays = jours_speciaux
)
)
validation <- cross_validation(
modele_cv,
initial = 730,
period = 90,
horizon = 90,
units = "days"
)
# Nombre de fen?tres de validation
length(
unique(validation$cutoff)
)
# Erreurs hors ?chantillon
erreur_cv <- validation$y -
validation$yhat
round(
c(
MAE =
mean(abs(erreur_cv)),
RMSE =
sqrt(
mean(erreur_cv^2)
),
MAPE =
100 *
mean(
abs(
erreur_cv /
validation$y
)
)
),
2
)
# Taux de couverture
round(
mean(
validation$y >= validation$yhat_lower &
validation$y <= validation$yhat_upper
),
3
)
# Tableau complet des performances
head(
performance_metrics(
validation
)
)
# Evolution de la MAPE avec l'horizon
plot_cross_validation_metric(
validation,
metric = "mape"
)
# INTERPRETATION :
# La validation crois?e temporelle est plus robuste
# qu'un seul d?coupage apprentissage/test.
#
# Elle permet d'?valuer le mod?le ? plusieurs dates
# de pr?vision diff?rentes.
#
# Si les erreurs augmentent avec l'horizon,
# les pr?visions deviennent moins pr?cises
# lorsque l'on cherche ? pr?voir plus loin.
# ============================================================
